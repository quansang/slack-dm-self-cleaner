{
  "manifest_version": 3,
  "name": "Slack DM Self Cleaner",
  "short_name": "DM Cleaner",
  "version": "0.2.0",
  "description": "Preview and delete only your own messages from the verified Slack peer DM or self-DM currently open in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Slack DM Self Cleaner",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle"
    }
  ]
}
